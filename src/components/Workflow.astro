---
const steps = [
  {
    num: '01',
    title: 'Enter known measurements',
    body: 'Use the dimensions or roofing squares from a source you already trust.',
  },
  {
    num: '02',
    title: 'Build the true job cost',
    body: 'Combine materials, labor, disposal, equipment and overhead.',
  },
  {
    num: '03',
    title: 'Set the target margin',
    body: 'Calculate the customer price and prepare a clear estimate.',
  },
];
---

<section class="section" id="workflow">
  <div class="wrap">
    <div class="eyebrow">How it works</div>
    <h2>A clear path from roof measurements to the right price</h2>
    <p class="section-intro">
      The difficult math stays connected, while the workflow stays simple.
    </p>
    <div class="steps">
      {steps.map((step) => (
        <article class="step card">
          <span class="step-num">{step.num}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .step {
    border-radius: 16px;
  }

  .step-num {
    color: var(--red);
    font-size: 12px;
    font-weight: 900;
  }

  .step h3 {
    margin-top: 38px;
  }

  .step p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 0;
  }

  @media (max-width: 850px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
